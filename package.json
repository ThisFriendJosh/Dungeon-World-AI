{
  "name": "dungeon-world-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "dev:dm": "node scripts/dm-dev.mjs",
    "build": "node scripts/desktop.mjs build",
    "build:ui": "npm run build --workspace @dwa/vtt-ui",
    "build:native": "node scripts/build-native.mjs",
    "start:native": "node scripts/native-dm.mjs",
    "check": "npm run typecheck --workspace @dwa/vtt-ui && npm run policy:offline",
    "test:engine": "cargo test --manifest-path services/engine/Cargo.toml",
    "test:ai": "cargo test --manifest-path services/ai/Cargo.toml",
    "test:dm-ui": "node --test tests/dm-panel.test.cjs",
    "check:rust": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "policy:offline": "node scripts/offline_policy_check.mjs",
    "test:ui": "npm run test:adapters --workspace @dwa/vtt-ui"
  }
}
