# Runtime
NODE_ENV=development

# App data root override (optional). If empty, OS default app-data dir is used.
DWA_DATA_DIR=

# Local AI development overrides (existing files only; no server URL).
# The complete offline distribution will supply application resource defaults.
LOCAL_LLM_SERVER_PATH=
LOCAL_LLM_MODEL_PATH=
DWA_DM_GPU_LAYERS=99
# Local image generation (optional overrides; weights installed by Setup-Local-Art.cmd).
DWA_ART_PYTHON_PATH=
DWA_ART_MODEL_DIR=
